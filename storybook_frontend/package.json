    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "^5.0.1"
  },
  "scripts": {
    "start": "storybook dev -p 3000 --host 0.0.0.0 --ci",
    "start:storybook": "storybook dev -p 3000 --host 0.0.0.0 --ci",
    "storybook": "storybook dev -p 3000 --host 0.0.0.0 --ci",
    "build-storybook": "storybook build",
